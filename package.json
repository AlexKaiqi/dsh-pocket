{
  "name": "dsh-pocket",
  "version": "0.1.0",
  "description": "把 DeepSeek Harness 装进你的口袋：电脑上跑 dsh web，手机扫码即同步访问（局域网 + 公网，实时同屏）。",
  "type": "module",
  "bin": {
    "dsh-pocket": "bin/dsh-pocket.mjs"
  },
  "exports": {
    ".": "./lib/proxy.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 \"test/*.test.js\""
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "mobile",
    "remote",
    "qr",
    "tunnel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaobeichen/dsh-pocket.git"
  },
  "bugs": {
    "url": "https://github.com/shaobeichen/dsh-pocket/issues"
  },
  "homepage": "https://github.com/shaobeichen/dsh-pocket"
}
